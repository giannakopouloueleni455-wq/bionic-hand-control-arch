import time
import threading
from collections import deque
import numpy as np

#  1. ΡΥΘΜΙΣΕΙΣ ΠΡΟΣΟΜΟΙΩΣΗΣ 
WINDOW_SIZE_MS = 150
STEP_MS = 50
SAMPLING_RATE_EMG = 1000  # Hz
BUFFER_LEN_EMG = int((WINDOW_SIZE_MS / 1000.0) * SAMPLING_RATE_EMG)

# Κυκλικές μνήμες προσομοίωσης
emg_buffer = deque(maxlen=BUFFER_LEN_EMG)
sensor_buffer = deque(maxlen=10)
vision_buffer = deque(maxlen=5)

lock = threading.Lock()

# 2.MOCK HARDWARE

def mock_emg_thread():
    """Προσομοίωση ροής sEMG στα 1000Hz"""
    while True:
        simulated_frame = np.random.randn(4) * 0.5
        with lock:
            emg_buffer.append(simulated_frame)
        time.sleep(1.0 / SAMPLING_RATE_EMG)


def mock_sensors_thread():
    """Προσομοίωση αισθητήρων (FSR & VL6180X Απόσταση) στα 100Hz"""
    while True:
        # Τυχαία απόσταση από 1.0 cm έως 15.0 cm
        simulated_distance = round(np.random.uniform(1.0, 15.0), 1)
        
        # Τυχαία τιμή πίεσης από 20 έως 400 αν η απόσταση είναι <= 5cm, αλλιώς 0
        simulated_fsr = float(np.random.randint(20, 400)) if simulated_distance <= 5.0 else 0.0
        
        sensor_data = {
            "distance": simulated_distance,
            "fsr": simulated_fsr,
            "timestamp": time.time()
        }
        with lock:
            sensor_buffer.append(sensor_data)
        time.sleep(0.01)

def mock_vision_thread():
    """Προσομοίωση κάμερας (επιστρέφει παραλληλόγραμμο σύλληψης x, y, theta, w, h)"""
    while True:
        simulated_bbox = {
            "x": 320, "y": 240, "theta": 12.5, "w": 45, "h": 25, 
            "valid": True
        }
        with lock:
            vision_buffer.append(simulated_bbox)
        time.sleep(0.05)


# 3. SMART GATING
def evaluate_smart_gating(latest_sensor, latest_vision):
    """
    Smart Gating: Εγκρίνει την κίνηση ΜΟΝΟ όταν το αντικείμενο 
    βρίσκεται σε απόσταση επαφής (<= 5cm) και η κάμερα το επιβεβαιώνει.
    """
    if not latest_sensor or not latest_vision:
        return False
    
    distance_ok = latest_sensor["distance"] <= 5.0
    object_detected = latest_vision.get("valid", False)
    
    return distance_ok and object_detected

# --- 4. ΚΕΝΤΡΙΚΟΣ ΒΡΟΧΟΣ ΠΡΟΣΟΜΟΙΩΣΗΣ (Συνεχής Ροή / Live Loop) ---
def run_simulation():
    print("EKKINHSH PROSOMOIOSIS")
    
    # Εκκίνηση νημάτων προσομοίωσης αισθητήρων
    threading.Thread(target=mock_emg_thread, daemon=True).start()
    threading.Thread(target=mock_sensors_thread, daemon=True).start()
    threading.Thread(target=mock_vision_thread, daemon=True).start()

    step_interval = STEP_MS / 1000.0  # 50 ms
    cycle_count = 0

    try:
        while True: # Τρέχει συνεχώς 
            loop_start = time.time()
            cycle_count += 1
            
            with lock:
                if len(emg_buffer) >= BUFFER_LEN_EMG and len(sensor_buffer) > 0 and len(vision_buffer) > 0:
                    latest_sensor = sensor_buffer[-1]
                    latest_vision = vision_buffer[-1]
                else:
                    time.sleep(0.01)
                    continue

            # Έλεγχος Smart Gating
            gating_approved = evaluate_smart_gating(latest_sensor, latest_vision)

            print(f"[Cycle {cycle_count}] Distance: {latest_sensor['distance']} cm | FSR: {latest_sensor['fsr']}")
            if gating_approved:
                print("  -> [SMART GATING: APPROVED] Object in touch range! Motor action triggered.")
            else:
                print("  -> [SMART GATING: BLOCKED] Movement prevented (Object too far or missing).")
            print("-" * 60)

            # Χρονικός σχεδιασμός βήματος (50 ms)
            elapsed = time.time() - loop_start
            if elapsed < step_interval:
                time.sleep(step_interval - elapsed)
                
    except KeyboardInterrupt:
        print(f"\n--- H prosomoiosi stamatise apo ton xristi ston kyklos {cycle_count} ---")

if __name__ == "__main__":
    run_simulation()
