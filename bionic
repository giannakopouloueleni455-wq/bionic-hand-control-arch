import time
import threading
from collections import deque
import numpy as np
import json

#  1. ΦΟΡΤΩΣΗ  DATASET 
try:
    with open("dataset.json", "r", encoding="utf-8") as f:
        OBJECT_DATASET = json.load(f)
except FileNotFoundError:
    print(" Δεν βρέθηκε το αρχείο dataset.json! .")
    OBJECT_DATASET = [{"label": "Default Object", "w": 30, "h": 50, "density": 0.3}]



#  2. ΡΥΘΜΙΣΕΙΣ ΠΡΟΣΟΜΟΙΩΣΗΣ 
WINDOW_SIZE_MS = 150
STEP_MS = 50
SAMPLING_RATE_EMG = 1000  # Hz
BUFFER_LEN_EMG = int((WINDOW_SIZE_MS / 1000.0) * SAMPLING_RATE_EMG)

emg_buffer = deque(maxlen=BUFFER_LEN_EMG)
sensor_buffer = deque(maxlen=10)
vision_buffer = deque(maxlen=5)

lock = threading.Lock()

#  3.ΨΕΥΤΙΚΑ ΔΕΔΟΜΕΝΑ
def mock_emg_thread():
    while True:
        simulated_frame = np.random.randn(4) * 0.5
        with lock:
            emg_buffer.append(simulated_frame)
        time.sleep(1.0 / SAMPLING_RATE_EMG)

def mock_sensors_thread():
    while True:
        simulated_distance = round(np.random.uniform(1.0, 15.0), 1)
        simulated_fsr = float(np.random.randint(50, 350)) if simulated_distance <= 5.0 else 0.0
        
        sensor_data = {
            "distance": simulated_distance,
            "fsr": simulated_fsr,
            "timestamp": time.time()
        }
        with lock:
            sensor_buffer.append(sensor_data)
        time.sleep(0.01)

def mock_vision_thread():
    """Προσομοίωση κάμερας που επιλέγει τυχαία αντικείμενο από το dataset"""
    while True:
        target = np.random.choice(OBJECT_DATASET)
        
        simulated_bbox = {
            "x": 320, "y": 240, "theta": 10.0, 
            "w": target["w"] + np.random.randint(-2, 2), 
            "h": target["h"] + np.random.randint(-2, 2), 
            "valid": True
        }
        with lock:
            vision_buffer.append(simulated_bbox)
        time.sleep(0.05)


# 4. ΑΝΑΓΝΩΡΙΣΗ ΚΑΙ ΕΚΤΙΜΗΣΗ 
def classify_object_from_dataset(detected_w, detected_h):
    best_match = None
    min_error = float('inf')
    
    for item in OBJECT_DATASET:
        error = abs(item["w"] - detected_w) + abs(item["h"] - detected_h)
        if error < min_error:
            min_error = error
            best_match = item
            
    return best_match

def evaluate_smart_gating(latest_sensor, latest_vision):
    if not latest_sensor or not latest_vision:
        return False
    return latest_sensor["distance"] <= 5.0 and latest_vision.get("valid", False)

def estimate_weight_and_rigidity(matched_item, latest_sensor):
    volume = matched_item["w"] * matched_item["h"]
    weight = round(volume * matched_item["density"], 1)
    
    fsr_value = latest_sensor.get("fsr", 0.0)
    rigidity = "Rigid / Hard" if fsr_value > 200 else ("Soft / Flexible" if fsr_value > 0 else "No Contact")
    
    return weight, rigidity



#  5. ΚΕΝΤΡΙΚΗ ΛΕΙΡΟΥΡΓΙΑ
def run_simulation():
    print(" EKKINHSH PROSOMOIOSIS ME DATASET ")
  
    
    threading.Thread(target=mock_emg_thread, daemon=True).start()
    threading.Thread(target=mock_sensors_thread, daemon=True).start()
    threading.Thread(target=mock_vision_thread, daemon=True).start()

    step_interval = STEP_MS / 1000.0
    cycle_count = 0

    
    while True:
            loop_start = time.time()
            cycle_count += 1
            
            with lock:
                if len(emg_buffer) >= BUFFER_LEN_EMG and len(sensor_buffer) > 0 and len(vision_buffer) > 0:
                    latest_sensor = sensor_buffer[-1]
                    latest_vision = vision_buffer[-1]
                else:
                    time.sleep(0.01)
                    continue

            matched_obj = classify_object_from_dataset(latest_vision["w"], latest_vision["h"])
            weight, rigidity = estimate_weight_and_rigidity(matched_obj, latest_sensor)
            gating_approved = evaluate_smart_gating(latest_sensor, latest_vision)

            print(f"[Cycle {cycle_count}] Distance: {latest_sensor['distance']} cm | Measured (w:{latest_vision['w']}, h:{latest_vision['h']})")
            print(f"  -> Detected Object: **{matched_obj['label']}** | Est. Weight: {weight} g | Texture: {rigidity}")
            
            if gating_approved:
                print("  -> [SMART GATING: APPROVED] Action triggered with customized grip!")
            else:
                print("  -> [SMART GATING: BLOCKED] Movement rejected (Out of reach).")
            print("-" * 75)

            elapsed = time.time() - loop_start
            if elapsed < step_interval:
                time.sleep(step_interval - elapsed)
                


if __name__ == "__main__":
    run_simulation()
